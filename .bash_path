################################
# Sourced by .bashrc for every shell, interactive or not, including nested ones.
# So everything here must be idempotent: re-running must not duplicate PATH entries.
# PATH arriving here:
#   macOS: path_helper (/etc/paths, /etc/paths.d), then brew shellenv in .bashrc
#   RHEL:  /etc/profile pathmunge + /etc/profile.d. Skel's ~/.local/bin:~/bin isn't
#          used because our .bash_profile replaces skel's.
#   Debian-family: /etc/environment (pam_env), /etc/profile; Ubuntu skel .profile adds
#          ~/bin and ~/.local/bin, but bash skips .profile, so we add them here.
################################
[ -f ~/.trace.sh ] && . ~/.trace.sh && log_startup ${BASH_SOURCE[0]} enter

# Helper function to move/add directory to the front of PATH.
# Moving (not skipping) matters on macOS: path_helper in /etc/profile pushes
# inherited entries behind /usr/bin in nested login shells (tmux, bash -l).
add_to_path() {
    local dir=${1%/} # Remove trailing /, if present
    [[ -d "$dir" ]] || return
    local p=":${PATH}:"
    p=${p//:${dir}:/:}
    p=${p#:}; p=${p%:}
    export PATH="${dir}${p:+:${p}}"
}

# Helper function to add directory to MANPATH only if not already present
add_to_manpath() {
    local dir=${1%/} # Remove trailing /, if present
    if [[ -d "${dir}" && ":${MANPATH}:" != *":${dir}:"* ]]; then
        export MANPATH="${dir}:${MANPATH}"
    fi
}

# On macos with homebrew we want to add any installed gnu utilities to our path.
# Reference: https://github.com/pkill37/linuxify/
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    for dir in $(ls -1d "${HOMEBREW_PREFIX}"/opt/*/libexec/gnubin 2>/dev/null); do
        if [[ $dir != */gsed/* ]]; then
            add_to_path "$dir"
        fi
    done
    for dir in $(ls -1d "${HOMEBREW_PREFIX}"/opt/*/libexec/gnuman 2>/dev/null); do
        if [[ $dir != */gsed/* ]]; then
            add_to_manpath "$dir"
        fi
    done
fi


# rust & cargo
[ -f "${HOME}/.cargo/env" ] && source "${HOME}/.cargo/env"

# local bins
add_to_path "${HOME}/go/bin"
add_to_path "${HOME}/.local/bin"
#add_to_path "${HOME}/.npm-global/bin"
add_to_path "${HOME}/bin"

unset add_to_path add_to_manpath

[ -f ~/.trace.sh ] && . ~/.trace.sh && log_startup ${BASH_SOURCE[0]} exit

